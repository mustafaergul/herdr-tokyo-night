{
  "id": "root",
  "type": "row",
  "theme": "graphite",
  "colors": {
    "foreground": "#c0caf5",
    "canvas": "#16161e",
    "chrome": "#16161e",
    "popover": "#1f2335",
    "raised": "#24283b",
    "hover": "#292e42",
    "selected": "#283457",
    "border": "#292e42",
    "input": "#414868",
    "muted": "#a9b1d6",
    "dim": "#565f89",
    "accent": "#7aa2f7",
    "accent_foreground": "#1a1b26",
    "solid": "#c0caf5",
    "solid_foreground": "#16161e",
    "ring": "#7aa2f7",
    "working": "#e0af68",
    "blocked": "#f7768e",
    "done": "#7dcfff",
    "idle": "#565f89",
    "unknown": "#565f89",
    "background": "#1a1b26",
    "terminal_foreground": "#c0caf5",
    "selection": "#283457",
    "cursor": "#c0caf5",
    "ansi0": "#15161e",
    "ansi1": "#f7768e",
    "ansi2": "#9ece6a",
    "ansi3": "#e0af68",
    "ansi4": "#7aa2f7",
    "ansi5": "#bb9af7",
    "ansi6": "#7dcfff",
    "ansi7": "#a9b1d6",
    "ansi8": "#414868",
    "ansi9": "#f7768e",
    "ansi10": "#9ece6a",
    "ansi11": "#e0af68",
    "ansi12": "#7aa2f7",
    "ansi13": "#bb9af7",
    "ansi14": "#7dcfff",
    "ansi15": "#c0caf5"
  },
  "preview": "layouts/tokyo-night.svg",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 46
          },
          "window_drag": true,
          "content": {
            "mod": "workspace-chrome"
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "spaces"
              }
            },
            {
              "id": "agents",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "agents"
              }
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 69
          },
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": {
            "px": 42
          },
          "window_drag": true,
          "content": {
            "mod": "tabs"
          }
        },
        {
          "id": "work-body",
          "type": "row",
          "padding": 8,
          "gap": 8,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 8,
                  "radius": 10,
                  "background": "background",
                  "lone": true,
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "height": 30,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": true,
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "files",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "size": {
            "px": 28
          },
          "content": {
            "mod": "workspace-status"
          }
        }
      ]
    }
  ]
}
